{
  "name": "krule",
  "version": "0.0.0",
  "private": true,
  "description": "krule CLI - discover, verify and report on a system's business logic",
  "bin": { "krule": "./src/main.ts" },
  "scripts": {
    "start": "tsx src/main.ts",
    "check-types": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
